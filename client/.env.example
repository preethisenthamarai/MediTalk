# Only needed if the API is hosted on a DIFFERENT domain than the website (e.g. Vercel + Render).
# Leave empty when the Express server serves the built client (single deployment) or in local dev.
VITE_API_URL=
VITE_SOCKET_URL=

# Optional TURN server for video calls behind strict NATs / mobile networks (see README)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
