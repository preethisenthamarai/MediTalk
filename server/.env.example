# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database (REQUIRED) ----------
# Local:  mongodb://127.0.0.1:27017/telemed
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/telemed?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/telemed

# ---------- Auth (REQUIRED: change both!) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# ---------- Machine translation ----------
# mock | mymemory | google | libretranslate
#   mock          -> works offline, prefixes text with [lang]; for UI testing only
#   mymemory      -> free, NO key needed (low daily limit) - good for demo
#   google        -> Google Cloud Translation v2, needs GOOGLE_TRANSLATE_API_KEY
#   libretranslate-> self-hosted / hosted LibreTranslate
TRANSLATION_PROVIDER=mymemory
# Optional: raises MyMemory free limit from ~5k to ~50k chars/day
MYMEMORY_EMAIL=
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=http://localhost:5001
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_MS=5000
